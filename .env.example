# Root domain used by middleware to map {slug}.youin.lol -> /i/{slug}
INVITE_ROOT_DOMAIN=youin.lol

# Upstash Redis (Vercel Marketplace). Preferred RSVP + created-invite store.
# vercel integration add upstash
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Neon Postgres (optional alternative if Upstash is unset).
# vercel integration add neon
# Accepts the pooled DATABASE_URL injected by the Neon integration.
DATABASE_URL=

# Optional. When both are set, new uploads can be re-styled by an image model
# through the Vercel AI Gateway. Without them, the local sticker pipeline runs
# and the invite falls back to the theme illustrations if cut-out fails.
AI_GATEWAY_API_KEY=
AI_GATEWAY_IMAGE_MODEL=
